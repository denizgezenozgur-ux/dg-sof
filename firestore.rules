rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function prof() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProf() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function inFleet(f) { return hasProf() && prof().fleet == f; }
    function isCap(f) { return signedIn() && request.auth.uid == f; }

    // Profiles: a captain creates his own; the captain creates his staff profiles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.fleet == request.auth.uid);
      allow create: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.role == 'cap' && request.resource.data.fleet == uid) ||
        (request.resource.data.role == 'staff' && request.resource.data.fleet == request.auth.uid));
      allow update, delete: if signedIn() && resource.data.fleet == request.auth.uid;
    }

    // Everything of a ship's crew lives under fleets/{captainUid}. Crew can read, only the captain writes...
    match /fleets/{f}/{document=**} {
      allow read: if inFleet(f);
      allow write: if isCap(f);
    }
    // ...except staff may write their own events...
    match /fleets/{f}/sofs/{s}/events/{e} {
      allow create: if inFleet(f) && (isCap(f) || request.resource.data.by == prof().memberId);
      allow update: if isCap(f) || (inFleet(f) && resource.data.by == prof().memberId && request.resource.data.by == prof().memberId);
      allow delete: if isCap(f) || (inFleet(f) && resource.data.by == prof().memberId);
    }
    // ...and add their own tally batches.
    match /fleets/{f}/sofs/{s}/tally/{b} {
      allow create: if inFleet(f) && (isCap(f) || request.resource.data.by == prof().memberId);
      allow update, delete: if isCap(f);
    }
  }
}
